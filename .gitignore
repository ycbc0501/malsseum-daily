# secrets — NEVER commit
pexels_key.txt
unsplash_key.txt
*_key.txt
meta_secrets.txt
.secrets

# python
__pycache__/
*.pyc

# transient render metadata (regenerated each run)
output/_path.txt
output/_caption.txt

# rendered media is hosted via GitHub Releases, never committed to git
output/

# video clips are fetched fresh at runtime, never committed
videos/

# quarantined audio (verify license before use)
music/*.bak

# Syncthing conflict copies. A duplicate file under .github/workflows/ is not cosmetic —
# GitHub Actions would run it too, and the account would post FOUR times a day.
*.sync-conflict-*
.syncthing.*.tmp
