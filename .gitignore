# secrets — NEVER commit
pexels_key.txt
unsplash_key.txt
*_key.txt
meta_secrets.txt
.secrets

# python
__pycache__/
*.pyc

# transient render metadata (regenerated each run)
output/_path.txt
output/_caption.txt

# rendered media is hosted via GitHub Releases, never committed to git
output/

# video clips are fetched fresh at runtime, never committed
videos/

# Investigation scratch. notes/*.md IS committed — the findings are the point — but the media
# pulled down to reach them is not: the 2026-10-06 ruled-line trace alone downloaded 457 MB of
# published reels, and every one of them is still on the `media` release if it is needed again.
# The frames worth keeping were downscaled into testdata/, which IS committed.
notes/**/*.mp4
notes/**/*.png
notes/**/*.jpg
notes/**/index.json
notes/**/seams.json
notes/**/joined*.json
notes/**/calib.json
notes/**/upper.json

# quarantined audio (verify license before use)
music/*.bak

# Syncthing conflict copies. A duplicate file under .github/workflows/ is not cosmetic —
# GitHub Actions would run it too, and the account would post FOUR times a day.
*.sync-conflict-*
.syncthing.*.tmp
